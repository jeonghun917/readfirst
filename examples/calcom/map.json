  "rules": [
    {
      "id": "prisma-select",
      "rule": "Prisma queries use select, not include",
      "why": "include fetches every field, sensitive ones included (AGENTS.md:7, 157-179)",
      "files": [
        "packages/**",
        "apps/api/**",
        "apps/web/**"
      ]
    },
    {
      "id": "no-credential-key",
      "rule": "credential.key is never selected into a query result or exposed in an API response",
      "why": "AGENTS.md:26, 108",
      "files": [
        "packages/app-store/**",
        "packages/features/credentials/**",
        "packages/trpc/**",
        "apps/api/**"
      ]
    },
    {
      "id": "no-barrel-imports",
      "rule": "import from the source file (@calcom/ui/components/button), never from a package's index.ts barrel; types through import type",
      "why": "AGENTS.md:8, 14, 30, 181-191",
      "files": [
        "apps/**",
        "packages/**"
      ]
    },
    {
      "id": "logic-in-services",
      "rule": "repositories only read and write data; business logic lives in services",
      "why": "AGENTS.md:29",
      "files": [
        "**/*Repository.ts",
        "**/*Service.ts"
      ]
    },
    {
      "id": "no-as-any",
      "rule": "no as any casts",
      "why": "AGENTS.md:25, 109",
      "files": [
        "apps/**",
        "packages/**"
      ]
    },
    {
      "id": "type-check-before-push",
      "rule": "type-check before pushing, and before calling a CI failure unrelated",
      "why": "AGENTS.md:13, 31, 83",
      "files": [
        "apps/**",
        "packages/**"
      ],
      "checks": [
        {
          "run": "yarn type-check:ci --force"
        }
      ]
    }
