  "rules": [
    {
      "id": "mcp-tool-contract",
      "rule": "an MCP tool pre-checks unique and FK constraints and throws ConflictException / BadRequestException, never returns void, carries title plus exactly one of readOnlyHint / destructiveHint, and does not mix read and write",
      "why": "a violation poisons the outer tenant transaction and fails at commit as a bare 500; undefined fails the CallToolResult schema (CLAUDE.md:77-80)",
      "files": [
        "packages/backend-core/src/modules/*/*.tools.ts"
      ]
    },
    {
      "id": "fence-third-party-text",
      "rule": "text from conversations, CRM fields, imported KB docs and connector records reaches a model only inside fenceUntrusted()",
      "why": "it is written by people outside the org (CLAUDE.md:70)",
      "files": [
        "packages/agent-runtime/**",
        "packages/backend-core/src/modules/conv/**",
        "packages/backend-core/src/modules/kb/**",
        "packages/backend-core/src/modules/crm/**"
      ]
    },
    {
      "id": "no-real-people-in-fixtures",
      "rule": "fixtures, changesets, commit messages and PR bodies use reserved domains, placeholder names and unassignable phone numbers",
      "why": "they are published and can't all be retracted (CLAUDE.md:102)",
      "files": [
        ".changeset/**",
        "**/*.test.ts",
        "packages/backend-core/src/modules/*/skills/*.md"
      ],
      "checks": [
        {
          "run": "node scripts/check-fixture-pii.mjs"
        }
      ]
    },
    {
      "id": "skill-names-real-tools",
      "rule": "a tool name in a skill must match a real @McpTool; renaming a tool means grepping the skills too",
      "why": "a tool name in a skill is a promise an agent will try to keep (CLAUDE.md:178)",
      "files": [
        "packages/backend-core/src/modules/*/skills/*.md",
        "packages/backend-core/src/modules/*/*.tools.ts"
      ],
      "checks": [
        {
          "run": "node scripts/check-skill-tool-refs.mjs"
        }
      ]
    },
    {
      "id": "migration-on-existing-db",
      "rule": "smoke-test a migration and its backfill against a DB already at the previous migration, as munin_app, before the PR",
      "why": "a backfill run only against an empty DB is untested, and a superuser hides RLS bugs (CLAUDE.md:117)",
      "files": [
        "packages/db/drizzle/**"
      ]
    }
