    {
      "id": "i18n-strings",
      "rule": "user-facing strings use Lingui macros; numbers, currencies and dates go through @superset/i18n/format, never Intl with a hardcoded locale; after changing strings run check:i18n and commit translations for every locale",
      "why": "nothing on CI fills translations (AGENTS.md:154-162)",
      "files": [
        "apps/desktop/src/**",
        "apps/web/src/**",
        "apps/mobile/**",
        "packages/ui/src/**",
        "packages/chat-ui/src/**"
      ],
      "checks": [
        {
          "run": "bun run check:i18n"
        }
      ]
    },
    {
      "id": "display-only-errors",
      "rule": "errorMessage() output is display-only; logs, Sentry/PostHog and error classification use rawErrorMessage() or the error object",
      "why": "it may be translated (AGENTS.md:166-168, packages/i18n/test/display-only.test.ts)",
      "files": [
        "apps/**",
        "packages/**"
      ]
    },
    {
      "id": "trpc-additive",
      "rule": "procedures that released clients call change only additively",
      "why": "desktop 1.24.0 got a 405 on every query to hosts on 1.23.x after a transport change (packages/trpc/AGENTS.md:34-36)",
      "files": [
        "packages/trpc/src/**",
        "packages/host-service/src/**"
      ]
    },
    {
      "id": "fast-deterministic-tests",
      "rule": "tests never wait for real timeouts, run in any order with no root .env, never mock.module something others import for real, and a flaky test is fixed or deleted, never retried",
      "why": "CI runs every suite in about two minutes (AGENTS.md:201-218)",
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx"
      ]
    },
    {
      "id": "plugins-declarative",
      "rule": "provisioners read the one installed_plugins.json; a caller never passes its own list",
      "why": "provisioning reaps whatever is absent, so the last writer deletes the others' skills (AGENTS.md:108-112)",
      "files": [
        "packages/host-service/src/**",
        "packages/cli/src/**",
        "apps/desktop/src/main/**"
      ]
    }
  ],
  "ignore": []
