  "rules": [
    {
      "id": "tasks-after-commit",
      "rule": "a Celery task is queued after the transaction commits (on_commit, or call_event for webhooks), never with a bare .delay() inside an open transaction",
      "why": "the task can start on another pod before the row it needs is committed (AGENTS.md:19-21, 436-448)",
      "files": [
        "saleor/**"
      ]
    },
    {
      "id": "atomic-writes",
      "rule": "counters change with F() expressions and upserts use update_or_create on a unique constraint; no check-then-act and no count += 1; save()",
      "why": "every operation runs concurrently with itself on many pods; the read-then-write loses updates (AGENTS.md:13-15, 341-379)",
      "files": [
        "saleor/**"
      ]
    },
    {
      "id": "short-locks",
      "rule": "select_for_update runs inside traced_atomic_transaction through the app's lock_objects module, is evaluated (list/get/__in) so it really locks, and the transaction stays short",
      "why": "a lazy lock queryset takes no lock; long locks stall the shared Postgres (AGENTS.md:382-421, 646-648)",
      "files": [
        "saleor/**"
      ]
    },
    {
      "id": "no-n-plus-one",
      "rule": "no per-row query or per-row save in a loop: bulk update/delete, .iterator() on unbounded querysets, fetch only the columns used, reuse dataloaders on hot paths",
      "why": "the shared Postgres is the scaling bottleneck and writes replicate to every read replica (AGENTS.md:22-24, 632-648)",
      "files": [
        "saleor/**"
      ]
    },
    {
      "id": "domain-never-imports-graphql",
      "rule": "code outside saleor/graphql never imports from saleor.graphql; a helper both need moves into the domain module",
      "why": "the GraphQL layer depends on the domain, never the reverse (AGENTS.md:273-275)",
      "files": [
        "saleor/account/**",
        "saleor/app/**",
        "saleor/asgi/**",
        "saleor/attribute/**",
        "saleor/auth/**",
        "saleor/channel/**",
        "saleor/checkout/**",
        "saleor/core/**",
        "saleor/csv/**",
        "saleor/discount/**",
        "saleor/giftcard/**",
        "saleor/invoice/**",
        "saleor/json_schemas/**",
        "saleor/menu/**",
        "saleor/order/**",
        "saleor/page/**",
        "saleor/payment/**",
        "saleor/permission/**",
        "saleor/plugins/**",
        "saleor/product/**",
        "saleor/schedulers/**",
        "saleor/seo/**",
        "saleor/shipping/**",
        "saleor/site/**",
        "saleor/tax/**",
        "saleor/thumbnail/**",
        "saleor/translations/**",
        "saleor/warehouse/**",
        "saleor/webhook/**"
      ]
    },
    {
      "id": "site-not-site-id",
      "rule": "the current site comes from Site.objects.get_current() (or get_site_promise), never settings.SITE_ID, and anything per-site is keyed by the resolved site",
      "why": "one process may serve several sites; SITE_ID alone lets one tenant read another's data (AGENTS.md:28-40)",
      "files": [
        "saleor/**"
      ]
    },
    {
      "id": "webhooks-through-call-event",
      "rule": "webhook events are dispatched with call_event(manager.method, ...) from saleor.core.utils.events, never by calling the plugin manager method directly",
      "why": "call_event defers the event until the transaction commits (AGENTS.md:19-21, 321-335)",
      "files": [
        "saleor/**"
      ]
    },
    {
      "id": "no-django-signals",
      "rule": "no Django signals (post_save, pre_delete, @receiver); call the logic explicitly from the code that triggers it",
      "why": "logic wired through signals is invisible at the call site; post_migrate is the one exception (AGENTS.md:83, 512)",
      "files": [
        "saleor/**"
      ]
    },
    {
      "id": "graphql-schema-versioned",
      "rule": "new GraphQL types, fields, mutations and inputs carry ADDED_IN_{VERSION} (type-level only for a new type), each mutation has its own error class, input lists are capped at 100, and schema.graphql is regenerated and committed",
      "why": "the changelog is generated from the annotations, and CI fails when the committed schema.graphql is behind the code (AGENTS.md:49-75, saleor/graphql/AGENTS.md:3-12, 30)",
      "files": [
        "saleor/graphql/**"
      ],
      "checks": [
        {
          "run": "python manage.py graphql_schema --schema saleor/graphql/schema.graphql && git diff --exit-code saleor/graphql/schema.graphql",
          "why": "the committed schema matches the code"
        }
      ]
    },
    {
      "id": "concurrent-indexes",
      "rule": "an index or unique constraint on an existing table is built CONCURRENTLY in its own migration with atomic = False and a reverse_sql that drops it IF EXISTS",
      "why": "a synchronous build takes an ACCESS EXCLUSIVE lock on the whole table (AGENTS.md:522-550, saleor/graphql/AGENTS.md:53)",
      "files": [
        "saleor/*/migrations/**"
      ]
    },
    {
      "id": "untrusted-files",
      "rule": "a downloaded file or URL is untrusted: confirm its type from magic bytes, allowlist formats (no SVG), cap the size, check the HTTP status before the body, and pass an explicit timeout",
      "why": "Content-Type is spoofable (AGENTS.md:309-312, 656-663)",
      "files": [
        "saleor/thumbnail/**",
        "saleor/graphql/core/validators/**",
        "saleor/core/http_client.py",
        "saleor/product/tasks.py",
        "saleor/graphql/product/utils.py",
        "saleor/app/installation_utils.py",
        "saleor/webhook/transport/utils.py",
        "saleor/plugins/openid_connect/**",
        "saleor/plugins/avatax/**"
      ]
    },
    {
      "id": "no-dev-imports",
      "rule": "saleor.core.development is imported only from tests, conftest.py and development-only commands like populatedb",
      "why": "it needs the dev dependency group (AGENTS.md:287-292)",
      "files": [
        "saleor/**"
      ]
    }
  ],
